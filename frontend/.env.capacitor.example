# Plantilla para compilar la app Android (Capacitor) contra un backend de la LAN.
#
# La app envuelta NO pasa por el proxy de Vite (eso es solo `npm run dev`):
# necesita la URL absoluta del backend horneada en el build. Copia este fichero
# a `.env.capacitor` (gitignored), pon la IP de tu PC en la red local y compila:
#
#   npm run build -- --mode capacitor
#   npx cap sync android
#   cd android && gradlew.bat assembleDebug
#
# Flujo completo en docs/dev-setup/android.md.
#
# OJO: http:// sin TLS solo funciona en el APK de DEBUG (cleartext permitido
# únicamente en android/app/src/debug/AndroidManifest.xml). En release, HTTPS.
VITE_API_URL=http://192.168.1.XX:8080
