# Identificación del responsable a efectos de la LSSI-CE (art. 10), inyectada al
# build de despliegue. Son datos SENSIBLES: NO se versionan con valores reales.
#
# Uso: copia este fichero a `.env.local` (gitignored) y rellena los valores
# REALES ahí. Vite carga `.env.local` automáticamente y hornea estas variables
# en el build de producción (`npm run build`). En el repositorio público y en CI
# estas variables NO existen: el aviso legal muestra entonces un texto de reserva
# que remite a la versión publicada en medeben.net/aviso-legal.
#
# IMPORTANTE: NUNCA pongas los valores reales en este fichero. `.env.example` SÍ
# se versiona; `.env.local` NO (lo ignora `*.local`).

# NIF del responsable (p. ej. X0000000X)
VITE_RESPONSABLE_NIF=

# Domicilio a efectos de notificaciones (una sola línea)
VITE_RESPONSABLE_DOMICILIO=
