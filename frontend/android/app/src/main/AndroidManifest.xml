<?xml version="1.0" encoding="utf-8" ?>
<!--
  allowBackup=false: sin backup automático a la cuenta de Google ni `adb backup`.
  El directorio de datos de la app incluye app_webview (cookies, IndexedDB,
  Cache Storage del Service Worker) y la app maneja datos laborales sensibles
  (RGPD, D38); esos datos no deben salir del dispositivo por el backup del
  sistema. Si algún día se quiere backup selectivo, usar
  android:dataExtractionRules excluyendo el directorio del WebView.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Anotar dónde fichas (opt-in, apagado de fábrica): solo ubicación
      aproximada, nunca precisa (D2 del contrato de implementación). El
      plugin @capacitor/geolocation declara ACCESS_FINE_LOCATION en su propio
      manifest y el manifest merger de AGP hace la unión — sin este
      tools:node="remove" el APK final pediría FINE aunque la app nunca lo use,
      contradiciendo lo declarado en Play Data Safety y en el consentimiento.
      Verificar tras `npx cap sync android` leyendo el manifest MERGEADO en
      android/app/build/intermediates/merged_manifests/ antes de cada release.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:node="remove" />
</manifest>
